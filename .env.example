# ============================================
# Consultorio Odontológico — Variables de entorno
# ============================================
# Copiá este archivo como .env y completá los valores.

# Clave secreta para sesiones y CSRF (obligatorio en producción)
SECRET_KEY=cambia-esta-clave-en-produccion

# Base de datos (SQLite por defecto)
# DATABASE_URL=sqlite:///instance/odontograma.db

# Código para registrar nuevos odontólogos
REGISTRATION_CODE=cambia-este-codigo

# Rate limiting (true en producción, false en tests)
RATELIMIT_ENABLED=true

# Correo saliente para "¿Olvidaste tu contraseña?".
# Si MAIL_SERVER queda vacío, la app no manda correos: escribe el enlace en
# logs/consultorio.log (sirve para probar en un equipo de desarrollo).
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=consultorio@gmail.com
# MAIL_PASSWORD=clave-de-aplicacion
# MAIL_USE_TLS=true
# MAIL_DEFAULT_SENDER=consultorio@gmail.com
# PASSWORD_RESET_MAX_AGE=3600

# Carpeta para subir archivos (opcional)
# UPLOAD_FOLDER=instance/uploads
